      "root",
      "sdk-debug",
      "send"
    ],
    "dataSlot": [
      "header-extra",
      "left",
      "right",
      "statusbar",
      "toolbar"
    ],
    "root": {
      "attributes": [
        "data-theme",
        "data-lt-theme",
        "data-composer",
        "data-chrome",
        "data-busy",
        "data-context-view"
      ],
      "classes": [
        "canvas-root",
        "chat"
      ],
      "mmdFormatOnlyClasses": [
        "lt-format-mmd"
      ]
    },
    "message": {
      "attributes": [
        "data-from",
        "data-state",
        "data-msg-id"
      ],
      "from": [
        "ai",
        "user",
        "system"
      ],
      "state": [
        "pending",
        "streaming",
        "done"
      ],
      "body": {
        "generatingAttribute": "data-generating"
      }
    },
    "statusbarSlotOnlyWhenFunctionBarNonEmpty": true,
    "stage": {
      "attribute": "data-stage",
      "states": [
        "closed",
        "content",
        "full"
      ]
    },
    "chrome": [
      "standard",
      "host",
      "shell"
    ],
    "legacySelectorsAlsoPresent": [
      ".mes",
      ".mes_text",
      "#msglistview",
      "#scrollview",
      ".chat-scope-box",
      "#chat"
    ],
    "prologue": {
      "scope": ".prologue-scope[data-lt=\"prologue\"]",
      "item": ".prologue-content"
    },
    "standardComposer": {
      "mmdSandboxSelectors": [
        "[data-chat=\"composer\"] textarea",
        ".composer-shortcut-wrap",
        "[data-chat=\"shortcut\"]",
        ".composer-row",
        "[data-chat=\"assistant\"][data-action=\"assistant\"]",
        ".chat-input-scope.composer-field",
        ".composer-field [data-chat=\"input\"]",
        ".composer-field [data-chat=\"model-chip\"][data-action=\"model\"]",
        ".composer-field [data-chat=\"send\"]",
        ".composer-tools",
        ".composer-row > .more-options-scope [data-action=\"more\"]",
        ".composer-row > .assistant-anchor > [data-chat=\"assistant\"]",
        "[data-chat=\"more-panel\"]"
      ],
      "absent": [
        "[data-chat=instruction-bar]",
        "[data-chat=instruction-chip]",
        "[data-chat=instruction-back]",
        "[data-chat=assistant-tip]"
      ],
      "differences": [
        "shortcut, assistant, send, model-chip and more are div[role=button], not <button>: button[...] and :disabled do not match",
        "shortcut buttons carry the platform feature key in data-shortcut, so [data-action=model] is only the model chip",
        ".composer-field sits inside .uni-textarea, the textarea two levels below .composer-field, more inside .more-options-scope: child and sibling combinators from MMD miss",
        "model-chip and send exist twice (collapsed and expanded rows); querySelector returns the collapsed one",
        ".assistant-anchor is display: contents until the card gives it a display",
        "in the sandbox shell the assistant node stays mounted; while read-only or without assist it has .is-off (display: none)"
      ]
    }
  },
  "nativeBlocks": {
    "blocks": [
      "[status]…[/status]",
      "[choices]…[/choices]"
    ],
    "closerOptional": true,
    "stopsBeforeTheOtherBlock": true,
    "appliesWhen": "the card's own display rules left the marker in an AI reply (a rule that consumes it wins); never for player lines",
    "stage": "after display rules, before Markdown and the sanitizer, on both render paths (shell and host)",
    "statusLine": "one key: value per line, ;; also separates; full-width punctuation normalised; a line without a colon is kept as text",
    "valueLadder": [
      "number",
      "n% or a/b → bar",
      "name|a/b → level",
      "k:v|k:v → list",
      "k:v k:v → stats",
      "name=number,… → entity chips",
      "a, b → tags",
      "a > b → path",
      "text"
    ],
    "drawnClasses": [
      "lt-status",
      "lt-status__row",
      "lt-status__k",
      "lt-status__v",
      "lt-bar",
