    "model": {
      "get": [
        "name",
        "cost",
        "capabilities"
      ],
      "capabilities": [
        "tools",
        "forcedTools",
        "jsonSchema",
        "imageInput"
      ],
      "capabilityStates": [
        "supported",
        "unsupported",
        "unknown"
      ],
      "changeEvent": "model:change; includes capability-only changes",
      "missingEvidence": "unknown; both tools and forcedTools must be supported before selecting a tool"
    },
    "generation": {
      "get": [
        "phase",
        "since",
        "outcome"
      ],
      "phases": [
        "idle",
        "preparing",
        "summarizing",
        "thinking",
        "writing"
      ],
      "outcome": [
        "kind",
        "label",
        "sub",
        "actions"
      ],
      "outcomeKinds": [
        "model-error",
        "network-error",
        "server-error",
        "rate-limit",
        "quota",
        "filtered",
        "length-cap",
        "stopped",
        "compact-retryable",
        "outcome-unconfirmed",
        "interrupted"
      ],
      "actions": [
        "retry",
        "continue",
        "switch-model",
        "model-settings",
        "capacity",
        "refresh",
        "retry-stream-off",
        "edit-message",
        "switch-lane",
        "resend-traditional"
      ],
      "outcomeIsNullWhile": "a reply is being generated, or the last turn ended normally",
      "labelsAre": "the same player-language text as the platform card under that row",
      "act": {
        "gestureOnly": "UNAUTHORIZED outside a trusted click (no dialog)",
        "unknownAction": "INVALID_ARGS",
        "whileGenerating": "BUSY",
        "withoutSend": "NOT_SUPPORTED",
        "rateLimit": "generation.act 3/min"
      }
    },
    "archive": {
      "item": [
        "id",
        "title",
        "isCurrent",
        "messageCount",
        "lastMessage",
        "createTime",
        "lastUpdateTime"
      ],
      "list": [
        "items",
        "count",
        "limit"
      ],
      "limitError": {
        "code": "LIMIT_REACHED",
        "data": [
          "count",
          "limit"
        ]
      },
      "gesture": "save/fork/open/start/rename/remove run directly inside a user gesture; outside one the shell asks first",
      "rateLimit": "archive.write 10/min"
    },
    "history": {
      "featureVersion": 1,
      "requiresProtocol": 2,
      "classic": "stage.history",
      "capabilities": [
        "version",
        "available",
        "reason"
      ],
      "page": [
        "conversationKey",
        "revision",
        "items",
        "complete",
        "cursor"
      ],
      "item": [
        "id",
        "order",
        "role",
        "kind",
        "state",
        "complete",
        "contentVersion",
        "content?",
        "toolCall?",
        "reason?",
        "reasonCode?"
      ],
      "changes": [
        "conversationKey",
        "previousRevision",
        "revision",
        "kind",
        "changes",
        "part",
        "final"
      ],
      "streamContent": false,
      "rawIdentities": false,
      "subscribeReturnsUnsubscribe": true,
      "pageLimit": 200,
      "contentPageBytes": 524288,
      "foregroundPollMs": 15000,
      "revisions": "decimal strings; stale continuation rejects; only the final page is complete",
      "lifecycle": "independent of mount/unmount; switch/dispose fences old responses"
    },
    "share": {
      "properties": [
        "enabled",
        "context",
        "audience",
        "poll"
      ],
      "contextPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "param": "share",
      "audiences": [
        "author",
        "link",
        "public"
      ],
      "link": {
        "sync": true,
        "invalidContext": "SHARE_CONTEXT_INVALID",
        "withoutHost": "HOST_DENIED",
        "whenDisabled": "returns the card link without the context (no error)",
        "keepsReferral": true
      },
      "qr": {
        "maxChars": 1024,
        "returns": [
          "size",
          "path"
        ],
        "pathIs": "SVG path in a size x size viewBox",
        "invalidText": "INVALID_ARGS",
        "withoutHost": "HOST_DENIED"
      },
      "contextIsNullWhile": "the page was not opened from a link with a valid context, the platform switch is off, or the player is viewing a past conversation",
      "neverSentToTheModel": true,
      "changeEvent": "share:change",
      "poll": {
        "shape": [
          "key",
          "options"
        ],
        "maxOptions": 12,
        "isNullWhile": "the page was not opened from a platform share-response link, the platform switch is off, or the player is viewing a past conversation",
        "tokenVisibleToCard": false
      },
      "tally": {
        "requiresProtocol": 2,
        "tallyLink": {
          "args": [
            "context",
            "pollKey"
          ],
          "returns": "url with ?share=~TOKEN and the sharer referral",
          "async": true,
          "prepareBeforeClick": true
        },
        "respond": {
          "args": [
            "option"
          ],
          "returns": [
            "ok"
          ],
          "ownLink": "NOT_ELIGIBLE"
        },
        "results": {
          "item": [
            "context",
            "pollKey",
            "total",
            "counts",
            "updatedAt"
          ],
          "countsAreNullBelow": 3,
          "countsUpdate": "daily",
          "totalIsLive": true,
          "ownerOnly": true
        }
      }
    },
    "context": {
      "requiresProtocol": 2,
      "capability": "contexts",
      "classic": null,
      "negotiation": "sdk.capabilities().contexts; without it every context/batch/state.set/main.onCompose call and any new message.send option throws NOT_SUPPORTED (never sent as plain text)",
      "idPattern": "^[A-Za-z0-9_-]{1,64}$",
      "idReserved": [
        "main"
      ],
      "instancePattern": "^[A-Za-z0-9_-]{1,64}$",
      "source": "omitted or \"card\" for the card itself; a workshopId from sdk.workshop.list() (kind dlc) for a DLC",
      "varsMaxBytes": 65536,
      "labelMaxChars": 24,
      "worldbooksMax": 64,
      "idempotencyKeyPattern": "^[A-Za-z0-9_.:-]{1,128}$",
      "listLimitMax": 100,
      "quoteManyMax": 16,
      "quoteManyMaxBytes": 2097152,
      "quoteAcceptsMessages": true,
      "retryAfterOn": [
        "PAUSED",
        "RATE_LIMITED"
      ],
      "run": {
        "resolvesOn": "terminal",
        "statuses": [
          "complete",
          "interrupted",
          "stopped",
          "failed",
          "moderated",
          "discarded"
        ],
        "returns": [
          "callId",
          "status",
          "text",
          "toolCall?",
          "reason?",
          "reasonCode?",
          "charged",
          "settled"
        ],
        "toolResultShape": "toolCall/reason (card tools); unavailable upstream uses reason service_unavailable; a tool reply cut off by the output limit has toolCall:null, reason interrupted and reasonCode output_limit, with any partial text",
        "options": [
          "instance",
          "source",
          "label",
          "worldbooks",
          "batch",
          "messages",
          "tool",
          "idempotencyKey",
          "onDelta",
          "signal"
        ],
        "unknownOption": "INVALID_ARGS"
      },
      "list": {
        "returns": [
          "entries",
          "nextAfterSeq"
        ],
        "entry": [
          "seq",
          "role",
          "content",
          "status",
          "callId",
          "anchorSeq",
          "charged",
          "settled",
          "toolCall?",
          "reason?",
          "reasonCode?",
          "vars?"
        ],
        "charged": "credits actually deducted for this entry; interrupted = the model wrote part of the reply and is charged for what it used; failed = no reply"
      },
      "models": {
        "returns": [
          "models",
          "selected"
        ],
        "model": [
          "id",
          "name",
          "lane?",
          "family?",
          "series?",
          "vendor?"
        ],
        "name": "model and lane as the player's model picker shows them, in the player's language",
        "family": "the value a declaration model.family names",
        "vendor": "the company that makes the model"
      },
      "clientMessages": {
        "roles": [
          "user",
          "assistant"
        ],
        "max": 1000,
        "maxBytes": 1048576,
        "lastMustBe": "non-empty user"
      },
      "stateSetMaxBytes": 16384,
      "messageSendOptions": [
        "as",
        "from",
        "batch",
        "messages"
      ],
      "noListing": "no call lists or describes declarations, lorebooks, presets or tools",
      "errors": [
        "NOT_SUPPORTED",
        "INVALID_ARGS",
        "CONTEXT_UNAVAILABLE",
        "CONFLICT",
        "BUSY",
        "LIMIT_REACHED",
        "INSUFFICIENT",
        "CHARGE_LIMIT",
        "PAUSED",
        "RATE_LIMITED",
        "MODEL_UNSUPPORTED",
        "BATCH_CLOSED",
        "NETWORK"
      ]
    },
    "shared": {
      "requiresProtocol": 2,
      "classic": "stage.shared",
      "keyPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "read": {
        "args": "key or list of keys",
        "maxKeys": 16,
        "undeclaredKeys": "omitted",
        "poll": [
          "kind",
          "counts",
          "total",
          "mine?"
        ],
        "counter": [
          "kind",
          "total",
          "mine?",
          "goal?",
          "reachedAt?",
          "previous?"
        ]
      },
      "vote": {
        "args": [
          "key",
          "option"
        ],
        "returns": [
          "mine"
        ]
      },
      "add": {
        "args": [
          "key",
          "delta"
        ],
        "deltaRange": [
          1,
          1000
        ],
        "returns": [
          "total",
          "mine",
          "reachedAt"
        ]
      },
      "leaderboard": {
        "args": [
          "key",
          "{ limit? }"
        ],
        "defaultLimit": 10,
        "maxLimit": 50,
        "item": [
          "rank",
          "name",
          "value"
        ],
        "mine": [
          "rank",
          "value"
        ]
      },
      "errors": [
        "SHARED_DISABLED",
        "NOT_DECLARED",
        "OPTION_INVALID",
        "NOT_ELIGIBLE",
        "RATE_LIMITED",
        "LIMIT_REACHED",
        "HOST_DENIED",
        "UNAUTHORIZED",
        "INVALID_ARGS",
        "NETWORK",
        "SHARE_CONTEXT_INVALID"
      ],
      "writesWhileViewingHistory": "HOST_DENIED",
      "withoutHost": "HOST_DENIED",
      "neverSentToTheModel": true
    },
    "stage": {
      "modes": [
        "content",
        "full"
      ],
      "unknownModeBecomes": "content",
      "elReturnsNodeWhenClosed": true,
      "ownCloseDoesNotEmitStageClose": true
    },
    "input": {
      "writesThrowWhileComposing": "INVALID_ARGS"
    },
    "message": {
      "cardTools": {
        "requiresProtocol": 3,
        "capability": "message.capabilities().tools",
        "send": "message.send(text,{tool:name})",
        "selection": "one server-declared tool; no per-turn schema",
        "terminal": [
          "toolCall",
          "reason?",
          "reasonCode?"
        ],
        "validArgs": "object",
        "invalidArgs": "raw inert string; valid:false",
        "missing": "toolCall:null with fixed reason",
        "streaming": "prose only; arguments delivered at terminal",
        "retries": 0,
        "execution": "card owns execution and writes results in the next turn text",
        "agentAndWorld": "reject before spending",
        "edit": "manual prose edit clears toolCall"
      },
      "sendBusy": "BUSY",
      "sendWithoutCapability": "NOT_SUPPORTED",
      "editWithoutCapability": "HOST_DENIED",
      "confirmOutsideGesture": true,
      "declinedCode": "UNAUTHORIZED",
      "editIdIs": "serverId (data-msg-id)"
    }
  },
  "save": {
    "keyPattern": "^[A-Za-z0-9_-]{1,64}$",
    "maxKeys": 10,
    "maxValueBytes": 65536,
    "valueMeasuredAs": "UTF-8 bytes of JSON.stringify(value)",
    "syncReadBeforeLoad": "HOST_DENIED",
    "crossDevice": true
  },
  "cache": {
    "quotaBytes": 1048576,
    "overQuota": "INVALID_ARGS",
    "lifetime": "page load"
  },
  "rateLimits": {
    "save.set": {
      "count": 20,
      "windowMs": 60000
    },
    "message.send.gesture": {
      "count": 3,
      "windowMs": 60000
    },
    "message.send.auto": {
      "count": 3,
      "windowMs": 60000
    },
    "message.edit": {
      "count": 10,
      "windowMs": 60000
    },
    "archive.write": {
      "count": 10,
      "windowMs": 60000
    },
    "generation.act": {
      "count": 3,
      "windowMs": 60000
    }
  },
  "errorCodes": [
    "UNAUTHORIZED",
    "RATE_LIMITED",
    "INVALID_ARGS",
    "HOST_DENIED",
    "NETWORK",
    "NOT_SUPPORTED",
    "BUSY",
    "UNKNOWN_CAPABILITY",
    "LIMIT_REACHED",
    "SHARE_CONTEXT_INVALID",
    "SHARED_DISABLED",
    "NOT_DECLARED",
    "OPTION_INVALID",
    "NOT_ELIGIBLE",
    "HISTORY_UNAVAILABLE",
    "HISTORY_STALE",
    "HISTORY_CURSOR_INVALID",
    "HISTORY_LIMIT",
    "CONTEXT_UNAVAILABLE",
    "CONFLICT",
    "INSUFFICIENT",
    "CHARGE_LIMIT",
    "PAUSED",
    "MODEL_UNSUPPORTED",
    "BATCH_CLOSED"
  ],
  "events": {
    "names": [
      "ready",
      "message:new",
      "message:done",
      "message:stream",
      "message:mount",
      "message:unmount",
      "input:change",
      "conversation:switch",
      "theme:change",
      "back",
      "stage:close",
      "dispose",
      "model:change",
      "generation:phase",
      "generation:outcome",
      "share:change",
      "state:change"
    ],
    "replayedToLateSubscribers": [
      "message:mount",
      "message:done"
    ],
    "latestReplayedToLateSubscribers": [
      "state:change"
    ],
    "stateReset": {
      "on": "conversation.switch",
      "requiresInitialValues": true,
      "messageId": null,
      "changes": [],
      "data": "initial values",
      "replayedToLateSubscribers": true
    },
    "readyReplayed": false,
    "coldStartOrder": [
      "message:new",
      "message:mount",
      "message:done",
      "…",
      "ready"
    ],
    "payload": {
      "message:new": [
        "content",
        "id",
        "role",
        "serverId"
      ],
      "message:mount": [
        "content",
        "id",
        "role",
        "serverId"
      ],
      "message:done": [
        "content",
        "id",
        "role",
        "serverId"
      ],
      "message:stream": [
        "content",
        "id",
        "role"
      ],
      "message:unmount": [
        "content",
        "id",
        "role",
        "serverId"
      ],
      "input:change": "string",
      "theme:change": "none",
      "model:change": [
        "cost",
        "name"
      ],
      "generation:phase": [
        "phase",
        "since"
      ],
      "generation:outcome": [
        "actions",
        "kind",
        "label",
        "sub"
      ],
      "share:change": "none",
      "state:change": [
        "changes",
        "data",
        "messageId"
      ],
      "conversation:switch": [
        "conversationId"
      ],
      "others": "none"
    },
    "roles": [
      "user",
      "ai"
    ],
    "systemRowsEmitNoEvents": true,
    "handlerArity": 1,
    "unknownEventNeverFires": true,
    "handlerErrorsIsolated": true,
    "doneOncePerMessage": true,
    "terminalCardToolFields": {
      "optional": [
        "toolCall",
        "reason"
      ],
      "appliesTo": [
        "message:new",
        "message:mount",
        "message:done",
        "message:unmount"
      ],
      "doneReasonCode": "service_unavailable for an unavailable upstream, output_limit for an output cutoff; toolCall:null, the existing reason (interrupted or unsupported) and any partial content are preserved",
      "historyContentFalse": "omits tool result, raw arguments and reasonCode",
      "legacySDK": "feature-detect message.capabilities before using options; old code may ignore extra arguments"
    },
    "virtualisation": "bubbles about two screen heights away are destroyed (message:unmount) and rebuilt (message:mount again); done is not repeated; streaming and the last two stay mounted",
    "querySelectorScope": "inside a handler and inside user-event handlers, document.querySelector* and getElementById search the current bubble first and never other bubbles; outside handlers the whole document (Element.querySelector is not patched)",
    "idStability": "id is a host-local id (l1, l2…) that changes across reloads; serverId is null for user messages and the greeting; persist on serverId or on content"
  },
  "nodes": {
    "dataChat": [
      "author-css",
      "author-script",
      "author-stage",
      "composer",
      "composer-row",
      "context-tabs",
      "header",
      "header-actions",
      "header-back",
      "header-title",
