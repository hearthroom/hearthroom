<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/update_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
<ImageView android:layout_width="80dp" android:layout_height="80dp" android:layout_marginTop="32dp" android:src="@drawable/icon" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/app_name" android:textSize="28sp" android:textColor="@color/text" android:gravity="center" />
<TextView android:id="@+id/version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/muted" android:gravity="center" />
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:textSize="20sp" android:textColor="@color/text" android:accessibilityLiveRegion="polite" />
<TextView android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:textColor="@color/muted" android:lineSpacingExtra="4dp" />
<ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="24dp" android:visibility="gone" android:max="100" />
<Button android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="24dp" android:text="@string/download_update" android:textAllCaps="false" android:visibility="gone" />
<Button android:id="@+id/open_site" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/open_site" android:textAllCaps="false" />
</LinearLayout></ScrollView>
